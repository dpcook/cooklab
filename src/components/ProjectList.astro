---
// "Current projects" on the disease pages.
interface Project {
  q: string;
  title: string;
  body: string;
  funding?: string;
}
interface Props {
  projects: Project[];
  class?: string;
}
const { projects, class: className = '' } = Astro.props;
---

<section class:list={['bg-surface-200 border-t border-navy-700/10', className]}>
  <div class="wrap py-16 md:py-24">
    <h2 class="section-title">Current projects</h2>
    <ul class="mt-10 m-0 p-0 list-none">
      {projects.map((p, i) => (
        <li class:list={['py-8 grid gap-4 md:gap-14 grid-cols-1 md:grid-cols-[1fr_1.35fr]', i === 0 ? 'border-t border-navy-700/15' : 'border-t border-navy-700/10']}>
          <div>
            <p class="question m-0 text-[24px] text-navy-700">{p.q}</p>
            <h3 class="mt-3 font-sans text-[15px] font-semibold tracking-normal leading-snug text-navy-700">{p.title}</h3>
          </div>
          <div>
            <p class="m-0 text-[15px] text-navy-700/70">{p.body}</p>
            {p.funding && <p class="meta mt-3 mb-0">{p.funding}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
