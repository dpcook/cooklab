---
interface Props {
  /** Tagline font-size in px */
  size?: number;
  /** Mark size in px (defaults to size * 1.3) */
  markSize?: number;
  showMark?: boolean;
  /** Mark colour. Default: rust. */
  markColor?: string;
}

const {
  size = 18,
  markSize,
  showMark = true,
  markColor = 'var(--color-rust-500)',
} = Astro.props;

const mark = markSize ?? Math.round(size * 1.3);
const gap = Math.max(8, Math.round(size * 0.45));
---

<span class="inline-flex items-center" style={`gap: ${gap}px;`}>
  {showMark && (
    <svg
      width={mark}
      height={mark}
      viewBox="0 0 32 32"
      fill="none"
      aria-hidden="true"
      style="display:block;flex-shrink:0;"
    >
      <circle cx="16" cy="16" r="14" stroke={markColor} stroke-width="1.5" />
      <circle cx="20" cy="13" r="4.5" fill={markColor} />
      <circle cx="12" cy="19" r="1.5" fill={markColor} fill-opacity="0.55" />
    </svg>
  )}
  <span
    class="font-display"
    style={`font-weight: 600; font-size: ${size}px; letter-spacing: -0.02em; line-height: 1; white-space: nowrap;`}
  >
    Decode. Design. Deliver.
  </span>
</span>
