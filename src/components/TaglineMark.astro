---
import ClusterMark from './ClusterMark.astro';

interface Props {
  /** Tagline font-size in px */
  size?: number;
  /** Mark size in px (defaults to size * 1.3) */
  markSize?: number;
  showMark?: boolean;
  /** Draw the mark in its dark-ground colours */
  dark?: boolean;
  /** Form the mark from cells when the pointer moves onto it (see ClusterMark) */
  animate?: boolean;
}

const { size = 18, markSize, showMark = true, dark = false, animate = false } = Astro.props;

const mark = markSize ?? Math.round(size * 1.3);
const gap = Math.max(8, Math.round(size * 0.45));
---

<span class="inline-flex items-center" style={`gap: ${gap}px;`}>
  {showMark && <ClusterMark size={mark} dark={dark} animate={animate} />}
  <span
    class="font-display"
    style={`font-weight: 600; font-size: ${size}px; letter-spacing: -0.02em; line-height: 1; white-space: nowrap;`}
  >
    Decode. Design. Deliver.
  </span>
</span>
