---
interface Props {
  /** Wordmark font-size in px */
  size?: number;
  /** Mark size in px (defaults to size * 1.3) */
  markSize?: number;
  /** Override colors. Default: text=navy, mark=rust */
  textColor?: string;
  markColor?: string;
}

const {
  size = 18,
  markSize,
  textColor = 'currentColor',
  markColor = 'var(--color-rust-500)',
} = Astro.props;

const mark = markSize ?? Math.round(size * 1.3);
const gap = Math.max(8, Math.round(size * 0.4));
---

<span
  class="inline-flex items-center"
  style={`gap: ${gap}px; color: ${textColor};`}
>
  <svg
    width={mark}
    height={mark}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    style="display:block;flex-shrink:0;"
  >
    <circle cx="16" cy="16" r="14" stroke={markColor} stroke-width="1.5" />
    <circle cx="20" cy="13" r="4.5" fill={markColor} />
    <circle cx="12" cy="19" r="1.5" fill={markColor} fill-opacity="0.55" />
  </svg>
  <span
    class="font-display"
    style={`font-weight: 300; font-size: ${size}px; letter-spacing: -0.03em; line-height: 1;`}
  >
    cook<span style="font-weight: 600;">lab</span>
  </span>
</span>
