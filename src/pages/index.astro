---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMorph from '../components/HeroMorph.astro';

const questions = [
  {
    q: 'Why does chemotherapy stop working?',
    body:
      "Most patients with high-grade serous ovarian cancer respond to first-line platinum chemotherapy — then relapse with disease that no longer responds. We're mapping the cell states that survive treatment and tracking how they re-emerge.",
    cta: 'Treatment resistance',
    href: '/research',
  },
  {
    q: 'Can we make ovarian cancer respond to immunotherapy?',
    body:
      "The ovarian tumour microenvironment is profoundly immunosuppressive, leaving checkpoint inhibitors and other immunotherapies largely ineffective. We're developing new therapeutics to reprogram the TME and unleash a durable anti-tumour response.",
    cta: 'Novel immunotherapies',
    href: '/research',
  },
  {
    q: 'How does endometriosis become cancer?',
    body:
      "Women with endometriosis face 2–3× the risk of ovarian cancer. We're tracing the cellular transitions from benign lesion to malignant transformation — catching the process before it progresses.",
    cta: 'Progression',
    href: '/research',
  },
];

// Mixed news feed — publications, funding, recruitment, talks, lab news.
// `meta` and `href` are both optional. Order top-down = most recent first.
const latest = [
  {
    tag: 'Preprint · 2026',
    title: 'Our new preprint on how tumour architecture shapes malignant phenotypes in HGSC is available online',
    href: 'https://www.biorxiv.org/content/10.64898/2026.05.27.727977v1',
  },
  {
    tag: 'New members · 2026',
    title: 'Welcome Sara, Michelle, Katrina, and Elizabeth to the lab!',
    href: '/people',
  },
  {
    tag: 'Publication · 2025',
    title: 'New collaborative study published in Nature Biotechnology exploring best practices in spatial genomics',
    meta: 'Plummer*, Dezem*, Cook*, Park* et al',
    href: 'https://doi.org/10.1038/s41587-025-02811-9',
  },
  {
    tag: 'Funding · 2025',
    title: 'CIHR Project Grant awarded — targeting malignant cell states in ovarian cancer',
    meta: '2025–2030 · $1.03M',
    href: '/research',
  },
  {
    tag: 'Funding · 2025',
    title: 'Cook Lab joins $6.5M CCS Breakthrough Team Grant on ovarian cancer dormancy',
    meta: 'Co-PI with Dr. Francis Rodier (CRCHUM) · 2025–2030',
    href: '/research',
  },
  {
    tag: 'Funding · 2025',
    title: 'CIHR Project Grant awarded — racial and ethnic disparities in endometriosis',
    meta: 'with Dr. Sony Singh and Benjamin Tsang · 2025–2030 · $1.05M',
    href: '/research',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout title="Cook Lab — Decoding Gynecologic Disease">
  <!-- Hero: text left, cells filling the space to its right -->
  <section class="relative overflow-hidden">
    <div class="wrap relative z-10 pt-12 pb-6 md:pt-16 lg:py-16 lg:min-h-[680px] lg:flex lg:items-center">
      <div class="lg:max-w-[35rem]">
        <h1 style="font-size: clamp(36px, 5.6vw, 58px); line-height: 1.06;">
          Decoding gynecologic disease to design new approaches for
          <em class="text-rust-500" style="font-style: italic; font-weight: 300;">prevention, detection, and treatment</em>.
        </h1>
        <p class="meta mt-7 mb-0">Ottawa Hospital Research Institute · University of Ottawa</p>
        <div class="mt-9">
          <a href="/research" class="btn btn-navy">Explore our research <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
    <HeroMorph anchor="left" class="hero-cells" />
  </section>

  <!-- Questions -->
  <section class="border-t border-navy-700/10">
    <div class="wrap py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="section-title">Questions we're asking</h2>
        <a href="/research" class="arrow-link">See all our research <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-10">
        {questions.map((q) => (
          <a href={q.href} class="group flex flex-col border-t border-navy-700/15 pt-6">
            <p class="question m-0 text-[24px] text-navy-700 group-hover:text-rust-600 transition-colors">{q.q}</p>
            <p class="mt-4 mb-0 flex-1 text-[15px] text-navy-700/70">{q.body}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-[15px] font-medium text-navy-700 group-hover:underline underline-offset-3">{q.cta} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest -->
  <section class="border-t border-navy-700/10">
    <div class="wrap py-16 md:py-20">
      <h2 class="section-title">Latest</h2>
      <ul class="mt-8 m-0 p-0 list-none border-t border-navy-700/15">
        {latest.map((item) => (
          <li class="border-b border-navy-700/10">
            <a
              href={item.href}
              target={isExternal(item.href) ? '_blank' : undefined}
              rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
              class="group grid gap-x-8 gap-y-1 py-5 items-baseline grid-cols-[1fr_auto] md:grid-cols-[10rem_1fr_auto]"
            >
              <span class="col-span-2 md:col-span-1 text-[14px] font-medium text-navy-400">{item.tag}</span>
              <span>
                <span class="block font-display text-[19px] text-navy-700 group-hover:text-rust-600 transition-colors" style="font-weight: 500; letter-spacing: -0.015em; line-height: 1.3;">
                  {item.title}
                </span>
                {item.meta && <span class="block meta mt-1">{item.meta}</span>}
              </span>
              <span class="text-navy-300 group-hover:text-navy-700 transition-colors" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.hero-cells) {
    width: 100%;
    aspect-ratio: 1;
    max-width: 640px;
    margin: 0 auto 2rem;
  }
  @media (min-width: 1024px) {
    /* From just inside the text column's right edge to the viewport edge (at most 800px) */
    :global(.hero-cells) {
      --text-end: calc(max(3rem, (100% - 72rem) / 2 + 3rem) + 35rem - 1.5rem);
      position: absolute;
      top: 0;
      bottom: 0;
      left: var(--text-end);
      width: min(800px, calc(100% - var(--text-end)));
      max-width: none;
      aspect-ratio: auto;
      margin: 0;
    }
  }
</style>
