---
import BaseLayout from '../layouts/BaseLayout.astro';
import TileShimmer from '../components/TileShimmer.astro';
import QuestionTiles from '../components/QuestionTiles.astro';

const questions = [
  {
    q: 'Why does chemotherapy stop working?',
    body:
      "Most patients with high-grade serous ovarian cancer respond to first-line platinum chemotherapy — then relapse with disease that no longer responds. We're mapping the cell states that survive treatment and tracking how they re-emerge.",
    cta: 'Treatment resistance',
    href: '/research',
    // the tumour cells appear first: the SecA, intermediate and SecB states
    strip: 'resist',
  },
  {
    q: 'Can we make ovarian cancer respond to immunotherapy?',
    body:
      "The ovarian tumour microenvironment is profoundly immunosuppressive, leaving checkpoint inhibitors and other immunotherapies largely ineffective. We're developing new therapeutics to reprogram the TME and unleash a durable anti-tumour response.",
    cta: 'Novel immunotherapies',
    href: '/research',
    // the immune cells appear first
    strip: 'immune',
  },
  {
    q: 'How does endometriosis become cancer?',
    body:
      "Women with endometriosis face 2–3× the risk of ovarian cancer. We're tracing the cellular transitions from benign lesion to malignant transformation — catching the process before it progresses.",
    cta: 'Progression',
    href: '/research',
    // endometriosis (EAOC-2, Xenium): the glandular epithelium appears first
    strip: 'endo',
  },
];

// Mixed news feed — publications, funding, recruitment, talks, lab news.
// `meta` and `href` are both optional. Order top-down = most recent first.
const latest = [
  {
    tag: 'Preprint · 2026',
    title: 'Our new preprint on how tumour architecture shapes malignant phenotypes in HGSC is available online',
    href: 'https://www.biorxiv.org/content/10.64898/2026.05.27.727977v1',
  },
  {
    tag: 'New members · 2026',
    title: 'Welcome Sara, Michelle, Katrina, and Elizabeth to the lab!',
    href: '/people',
  },
  {
    tag: 'Publication · 2025',
    title: 'New collaborative study published in Nature Biotechnology exploring best practices in spatial genomics',
    meta: 'Plummer*, Dezem*, Cook*, Park* et al',
    href: 'https://doi.org/10.1038/s41587-025-02811-9',
  },
  {
    tag: 'Funding · 2025',
    title: 'CIHR Project Grant awarded — targeting malignant cell states in ovarian cancer',
    meta: '2025–2030 · $1.03M',
    href: '/research',
  },
  {
    tag: 'Funding · 2025',
    title: 'Cook Lab joins $6.5M CCS Breakthrough Team Grant on ovarian cancer dormancy',
    meta: 'Co-PI with Dr. Francis Rodier (CRCHUM) · 2025–2030',
    href: '/research',
  },
  {
    tag: 'Funding · 2025',
    title: 'CIHR Project Grant awarded — racial and ethnic disparities in endometriosis',
    meta: 'with Dr. Sony Singh and Benjamin Tsang · 2025–2030 · $1.05M',
    href: '/research',
  },
];

const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout title="Cook Lab — Decoding Gynecologic Disease" dark overlayHeader>
  <!-- Hero: the tagline over a tumour section in glass tiles, which fades into the ground on the left -->
  <section class="home-hero relative overflow-hidden">
    <img
      src="/mosaic/home-hero.webp"
      srcset="/mosaic/home-hero-1440.webp 1440w, /mosaic/home-hero.webp 2880w"
      sizes="100vw"
      alt=""
      width="2880"
      height="1620"
      class="absolute inset-0 w-full h-full object-cover object-right"
      fetchpriority="high"
      decoding="async"
    />
    <TileShimmer src="/mosaic/home-shimmer.json" />
    <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative z-10 hero-inner">
      <div class="flex flex-col gap-7">
        <h1 class="tagline">Decode.<br />Design.<br />Deliver.</h1>
        <p class="mission m-0">Improving outcomes for those with gynecologic disease</p>
        <div class="mt-2">
          <a href="/research" class="btn btn-light">Explore our research <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Questions -->
  <section>
    <div class="wrap pt-10 pb-16 md:pt-14 md:pb-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="section-title text-white">Questions we're asking</h2>
        <a href="/research" class="arrow-link">See all our research <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-12">
        {questions.map((q) => (
          <a href={q.href} class="q-card group flex flex-col">
            <QuestionTiles name={q.strip} />
            <p class="question mt-6 mb-0 text-[24px] text-white group-hover:text-rust-400 transition-colors">{q.q}</p>
            <p class="mt-4 mb-0 flex-1 text-[15px] text-on-dark-muted">{q.body}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-[15px] font-medium text-on-dark group-hover:underline underline-offset-3">{q.cta} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest -->
  <section class="border-t border-white/8">
    <div class="wrap py-16 md:py-20">
      <h2 class="section-title text-white">Latest</h2>
      <ul class="mt-8 m-0 p-0 list-none border-t border-white/12">
        {latest.map((item) => (
          <li class="border-b border-white/8">
            <a
              href={item.href}
              target={isExternal(item.href) ? '_blank' : undefined}
              rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
              class="group grid gap-x-8 gap-y-1 py-5 items-baseline grid-cols-[1fr_auto] md:grid-cols-[11rem_1fr_auto]"
            >
              <span class="col-span-2 md:col-span-1 text-[14px] font-medium text-on-dark-muted">{item.tag}</span>
              <span>
                <span class="block font-display text-[19px] text-navy-100 group-hover:text-rust-400 transition-colors" style="font-weight: 500; letter-spacing: -0.015em; line-height: 1.3;">
                  {item.title}
                </span>
                {item.meta && <span class="block meta mt-1">{item.meta}</span>}
              </span>
              <span class="text-navy-400 group-hover:text-white transition-colors" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* No taller than the image's own proportions (2880 × 1620), so the tissue keeps its place on the right */
  .home-hero {
    height: min(100vh, 56.25vw, 880px);
    height: min(100svh, 56.25vw, 880px);
    min-height: 640px;
  }
  /* Darken the left, where the text sits, the strip under the header, and the foot of the
     hero so it runs into the section below */
  .hero-scrim {
    background:
      linear-gradient(0deg, var(--color-ground) 0%, rgb(10 17 32 / 0) 16%),
      linear-gradient(180deg, rgb(10 17 32 / 0.85) 0%, rgb(10 17 32 / 0.45) 9%, rgb(10 17 32 / 0) 20%),
      linear-gradient(90deg, rgb(10 17 32 / 0.92) 0%, rgb(10 17 32 / 0.78) 30%, rgb(10 17 32 / 0.3) 44%, rgb(10 17 32 / 0) 56%);
  }
  .hero-inner {
    height: 100%;
    display: flex;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .tagline {
    margin: 0;
    color: #fff;
    font-weight: 700;
    font-size: clamp(48px, 6.2vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .mission {
    max-width: 350px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(20px, 1.9vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-navy-200);
  }
  @media (max-width: 767px) {
    .hero-scrim {
      background:
        linear-gradient(0deg, var(--color-ground) 0%, rgb(10 17 32 / 0) 18%),
        linear-gradient(180deg, rgb(10 17 32 / 0.9) 0%, rgb(10 17 32 / 0.72) 55%, rgb(10 17 32 / 0.35) 100%);
    }
  }
</style>
