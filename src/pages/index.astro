---
import BaseLayout from '../layouts/BaseLayout.astro';
import UmapSpatialTwin from '../components/UmapSpatialTwin.astro';
import TaglineMark from '../components/TaglineMark.astro';

const questions = [
  {
    q: "Why does chemotherapy stop working?",
    body:
      "Most patients with high-grade serous ovarian cancer respond to first-line platinum chemotherapy — then relapse with disease that no longer responds. We're mapping the cell states that survive treatment and tracking how they re-emerge.",
    cta: 'Treatment resistance',
    href: '/research',
  },
  {
    q: 'Can we make ovarian cancer respond to immunotherapy?',
    body:
      "The ovarian tumour microenvironment is profoundly immunosuppressive, leaving checkpoint inhibitors and other immunotherapies largely ineffective. We're developing new therapeutics to reprogram the TME and unleash a durable anti-tumour response.",
    cta: 'Novel immunotherapies',
    href: '/research',
  },
  {
    q: 'How does endometriosis become cancer?',
    body:
      "Women with endometriosis face 2–3× the risk of ovarian cancer. We're tracing the cellular transitions from benign lesion to malignant transformation — catching the process before it progresses.",
    cta: 'Progression',
    href: '/research',
  },
];

// Mixed news feed — publications, funding, recruitment, talks, lab news.
// `meta` and `href` are both optional. Order top-down = most recent first.
const latest = [
  {
    tag: 'PREPRINT · 2026',
    title: 'Our new preprint on how tumour architecture shapes malignant phenotypes in HGSC is available online',
    href: 'https://www.biorxiv.org/content/10.64898/2026.05.27.727977v1',
  },
  {
    tag: 'NEW MEMBERS · 2026',
    title: 'Welcome Sara, Michelle, Katrina, and Elizabeth to the lab!',
    href: '/people',
  },
  {
    tag: 'PUBLICATION · 2025',
    title: 'New collaborative study published in Nature Biotechnology exploring best practices in spatial genomics',
    meta: 'Plummer*, Dezem*, Cook*, Park* et al',
    href: 'https://doi.org/10.1038/s41587-025-02811-9',
  },
  {
    tag: 'FUNDING · 2025',
    title: 'CIHR Project Grant awarded — targeting malignant cell states in ovarian cancer',
    meta: '2025–2030 · $1.03M',
    href: '/research',
  },
  {
    tag: 'FUNDING · 2025',
    title: 'Cook Lab joins $6.5M CCS Breakthrough Team Grant on ovarian cancer dormancy',
    meta: 'Co-PI with Dr. Francis Rodier (CRCHUM) · 2025–2030',
    href: '/research',
  },
  {
    tag: 'FUNDING · 2025',
    title: 'CIHR Project Grant awarded — racial and ethnic disparities in endometriosis',
    meta: 'with Dr. Sony Singh and Benjamin Tsang · 2025–2030 · $1.05M',
    href: '/research',
  },
];
---

<BaseLayout title="Cook Lab — Decoding Gynecologic Disease">
  <!-- ─────────── Hero ─────────── -->
  <section class="max-w-6xl mx-auto px-5 md:px-10 pt-8 pb-6">
    <div class="grid items-start gap-6 md:gap-2 grid-cols-1 md:grid-cols-[1fr_1.1fr]">
      <div>
        <div class="eyebrow">Ottawa Hospital Research Institute · University of Ottawa</div>
        <h1
          class="mt-5 text-balance"
          style="font-size: clamp(34px, 7vw, 52px); line-height: 1.02; max-width: 620px;"
        >
          Decoding gynecologic disease to design new approaches for <em
            class="text-rust-500"
            style="font-style: italic; font-weight: 400;"
          >prevention, detection, and treatment</em>.
        </h1>
        <div class="mt-5 text-navy-700">
          <TaglineMark size={18} showMark={false} layout="inline-tight" />
        </div>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/research"
            class="inline-flex items-center gap-1.5 bg-rust-500 hover:bg-rust-600 text-white rounded-md transition-colors"
            style="padding: 11px 18px; font-size: 13px; font-weight: 500; text-decoration: none;"
          >
            Explore our research <span aria-hidden="true">→</span>
          </a>
          <a
            href="/join"
            class="inline-flex items-center gap-1.5 text-navy-700 border border-navy-700/20 hover:border-navy-700/40 rounded-md transition-colors"
            style="padding: 11px 18px; font-size: 13px; font-weight: 500; text-decoration: none;"
          >
            Join the lab
          </a>
        </div>
      </div>

      <div>
        <UmapSpatialTwin />
      </div>
    </div>
  </section>

  <!-- ─────────── Questions we're asking ─────────── -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="max-w-6xl mx-auto px-5 md:px-10 pt-8 pb-12">
      <div class="flex justify-between items-baseline mb-7">
        <div class="eyebrow">Questions we're asking</div>
        <a
          href="/research"
          class="font-mono text-navy-700/45 hover:text-rust-500 transition-colors"
          style="font-size: 10px; letter-spacing: 0.1em; text-decoration: none;"
        >
          SEE ALL OUR RESEARCH →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {questions.map((q) => (
          <a
            href={q.href}
            class="bg-white border border-navy-700/10 hover:border-navy-700/20 rounded-lg p-6 flex flex-col transition-colors"
            style="min-height: 220px; text-decoration: none;"
          >
            <div
              class="font-display text-navy-700"
              style="font-style: italic; font-weight: 400; font-size: 22px; letter-spacing: -0.015em; line-height: 1.2;"
            >
              {q.q}
            </div>
            <div class="text-navy-700/65 mt-3.5 flex-1" style="font-size: 13px; line-height: 1.5;">
              {q.body}
            </div>
            <div
              class="mt-4 flex items-center gap-1.5 text-rust-500"
              style="font-size: 12px; font-weight: 500;"
            >
              <span>{q.cta}</span><span aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────── Latest ─────────── -->
  <section class="border-t border-navy-700/10">
    <div class="max-w-6xl mx-auto px-5 md:px-10 py-10">
      <div class="eyebrow mb-4">Latest</div>
      {latest.map((item) => {
        const Tag = item.href ? 'a' : 'div';
        return (
          <Tag
            href={item.href}
            class:list={[
              'flex gap-5 items-start py-4 border-t border-navy-700/10',
              item.href && 'group'
            ]}
            style="text-decoration: none;"
          >
            <div class="flex-1">
              <div
                class="font-mono text-rust-500"
                style="font-size: 9px; letter-spacing: 0.1em;"
              >
                {item.tag}
              </div>
              <div
                class="font-display text-navy-700 mt-1"
                style="font-size: 16px; font-weight: 500; letter-spacing: -0.01em; line-height: 1.3;"
              >
                {item.title}
              </div>
              {item.meta && (
                <div class="text-navy-700/65 mt-1" style="font-size: 12px;">{item.meta}</div>
              )}
            </div>
            {item.href && (
              <div class="text-navy-700/45 group-hover:text-rust-500 transition-colors" style="font-size: 16px;">→</div>
            )}
          </Tag>
        );
      })}
    </div>
  </section>
</BaseLayout>
