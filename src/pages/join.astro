---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const tracks = [
  {
    title: 'Postdoctoral Fellows',
    body: 'We look for postdocs with strong backgrounds in molecular biology, single-cell or spatial genomics, computational biology, or clinical/translational research. Funded positions are announced here when available.',
    apply: 'Email David directly with your CV and a brief statement of research interests. Tell us which of our research questions most interests you.',
  },
  {
    title: 'Graduate Students (PhD / MSc)',
    body: 'We supervise students through the Department of Cellular and Molecular Medicine at the University of Ottawa. Admission requires supervisor commitment before formally applying, so interested students should reach out first to discuss fit.',
    apply: "Email David with your CV and a short paragraph on why you're interested in our research. If there's a fit, we'll coordinate your application to the CMM program together.",
  },
  {
    title: 'Undergraduates',
    body: 'We host honors thesis students, summer research trainees, and fourth-year co-op placements. Positions are competitive; we prioritize students with strong academic records and demonstrated interest in gynecologic research or genomics.',
    apply: 'Email David in late fall/early winter for positions the following academic year.',
  },
];
---

<BaseLayout title="Join — Cook Lab">
  <PageHeader title="Join us." cloud="/mosaic/header-join">
    We're always excited to hear from talented trainees who share our commitment to understanding and
    treating gynecologic disease.
  </PageHeader>

  <!-- The lab -->
  <section>
    <div class="wrap pb-16 md:pb-20 grid gap-10 md:gap-14 items-center grid-cols-1 md:grid-cols-[1fr_1.3fr]">
      <p class="m-0 text-[17px] text-navy-700/75 leading-[1.7] max-w-xl">
        Our lab is home to people from diverse fields and backgrounds, and we prioritize mentorship
        and autonomy. We're an energetic team that values ambition, drive, and curiosity.
      </p>
      <img
        src="/lab/group-stairs.jpeg"
        alt="Cook Lab members"
        class="block w-full rounded-2xl"
        style="aspect-ratio: 3 / 2; object-fit: cover;"
      />
    </div>
  </section>

  <!-- Tracks -->
  <section class="border-t border-navy-700/10">
    <div class="wrap py-16 md:py-24">
      <h2 class="section-title">How to reach us</h2>
      <div class="mt-10">
        {tracks.map((t, i) => (
          <div class:list={['grid gap-5 md:gap-14 py-8 items-start grid-cols-1 md:grid-cols-[1.1fr_1fr]', i === 0 ? 'border-t border-navy-700/15' : 'border-t border-navy-700/10']}>
            <div>
              <h3 class="item-title text-[24px]">{t.title}</h3>
              <p class="mt-3 mb-0 text-[15px] text-navy-700/70">{t.body}</p>
            </div>
            <div class="rounded-xl bg-surface-200 p-6">
              <h4 class="font-sans text-[15px] font-semibold tracking-normal text-navy-700" style="line-height: 1.3;">How to apply</h4>
              <p class="mt-2 mb-0 text-[15px] text-navy-700/80">{t.apply}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="wrap py-16 md:py-20 grid gap-10 md:gap-16 items-end grid-cols-1 md:grid-cols-[1.4fr_1fr]">
      <div>
        <h2 class="section-title">Dr. David P. Cook</h2>
        <a href="mailto:dacook@ohri.ca" class="inline-block mt-3 text-[20px]">dacook@ohri.ca</a>
        <p class="mt-6 mb-0 text-[16px] text-navy-700/70 max-w-lg leading-[1.65]">
          When you reach out, please tell us which of our research questions most interests
          you, and why. This helps us understand fit before we connect further.
        </p>
      </div>
      <address class="not-italic meta text-[15px] leading-[1.7]">
        Ottawa Hospital Research Institute<br />
        Centre for Cancer Therapeutics<br />
        501 Smyth Road<br />
        Ottawa, ON
      </address>
    </div>
  </section>
</BaseLayout>
