---
import BaseLayout from '../layouts/BaseLayout.astro';

// Categorical dataviz palette (rustNavy) — used for placeholder member avatars
const dv = ['#C2410C', '#0F172A', '#0D9488', '#A16207', '#7C3AED', '#64748B', '#DC2626', '#0369A1'];

// Lab members from brief §5.7 — active first, then incoming.
// Roles per brief; "TBC" left intentionally as placeholder for v1.
const members = [
  // Research Technician
  { name: 'Hugh Deng', role: 'Research Technician', c: 4, photo: true },
  // Postdoctoral Fellows
  { name: 'Sarah Nersesian, PhD', role: 'Postdoctoral Fellow', c: 0, photo: true },
  { name: 'John Abou-Hamad, PhD', role: 'Postdoctoral Fellow', c: 1, photo: true },
  { name: 'Elizabeth Hughes, PhD', role: 'Postdoctoral Fellow', incoming: true, c: 0 },
  // PhD
  { name: 'Emma Durocher', role: 'PhD (Cellular and Molecular Medicine)', c: 2, photo: true },
  { name: "Colin O'Dwyer", role: 'PhD (Microbiology and Immunology)', note: 'co-supervised w/ Dr. Michele Ardolino', c: 6, photo: true },
  // MSc
  { name: 'Athena Southworth', role: 'MSc (Cellular and Molecular Medicine)', c: 3, photo: true },
  // Undergraduate
  { name: 'Katrina Verey', role: 'Undergraduate (TMM-PhD)', c: 1, photo: true },
  { name: 'Michelle Sukadil', role: 'Undergraduate (Biomedical Sciences)', c: 2, photo: true },
  { name: 'Sara Popovic', role: 'Undergraduate (Computing, Queen’s University)', c: 3, photo: true },
];

const alumni = [
  { name: 'Bhavya Joshi', role: 'Undergraduate (TMM)', current: 'TBD', year: 2026 },
  { name: 'Judy Sobh', role: 'MSc (Cellular and Molecular Medicine)', current: 'TBD', year: 2026 },
];

const slugify = (name: string) =>
  name.toLowerCase().split(',')[0].replace(/'/g, '').replace(/\s+/g, '-');

const initials = (name: string) =>
  name
    .replace(/[^A-Za-z\s'-]/g, '')
    .split(/\s+/)
    .map((p) => p[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();

const piLinks = [
  { label: 'dpcook.com', href: 'https://dpcook.com' },
  { label: 'Email', href: 'mailto:dacook@ohri.ca' },
  { label: 'Scholar', href: 'https://scholar.google.ca/citations?hl=en&pli=1&user=aBCxvUIAAAAJ' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/david-cook-43266577/' },
];

---

<BaseLayout title="People — Cook Lab">
  <!-- ── Intro ───────────────────────────────────────────────────────── -->
  <section class="max-w-6xl mx-auto px-5 md:px-10 pt-8 pb-8">
    <div class="eyebrow">PEOPLE</div>
    <h1
      class="font-display text-navy-700 mt-4 max-w-3xl"
      style="font-weight: 300; letter-spacing: -0.035em; font-size: clamp(28px, 6vw, 44px); line-height: 1.05;"
    >
      We value
      <em class="text-rust-500" style="font-style: italic; font-weight: 400;">curiosity</em>,
      <em class="text-rust-500" style="font-style: italic; font-weight: 400;">care</em>, and
      <em class="text-rust-500" style="font-style: italic; font-weight: 400;">drive</em>
      to answer the most impactful questions in gynecologic disease.
    </h1>
    <p class="mt-6 text-navy-700/65 text-[15px] leading-relaxed max-w-3xl">
      We're always looking for talented people.
      <a href="/join" class="text-rust-500 hover:text-rust-600 font-medium">Join the lab →</a>
    </p>
  </section>

  <!-- ── PI feature card ─────────────────────────────────────────────── -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="max-w-6xl mx-auto px-5 md:px-10 pt-10 pb-16">
      <div class="eyebrow mb-6">PI</div>
      <div class="grid gap-6 md:gap-8 p-6 md:p-8 bg-white border border-navy-700/10 rounded-xl items-start grid-cols-1 lg:grid-cols-[340px_1fr_auto]">
        <!-- PI portrait -->
        <img
          src="/people/david-cook.jpeg"
          alt="David P. Cook"
          width="1200"
          height="1200"
          class="rounded-lg block w-full max-w-[340px] mx-auto lg:mx-0"
          style="aspect-ratio: 1 / 1; object-fit: cover;"
        />

        <!-- PI text -->
        <div class="min-w-0">
          <div class="font-mono text-rust-500 uppercase" style="font-size: 11px; letter-spacing: 0.16em;">
            PRINCIPAL INVESTIGATOR
          </div>
          <h2
            class="font-display text-navy-700 mt-2"
            style="font-weight: 300; letter-spacing: -0.035em; font-size: clamp(26px, 5vw, 36px); line-height: 1;"
          >
            David P. Cook, PhD
          </h2>
          <div class="mt-4 text-navy-700/65 text-[13px] leading-relaxed">
            <span class="font-semibold text-navy-700">Scientist</span> — Cancer Research Program, Ottawa Hospital Research Institute<br />
            <span class="font-semibold text-navy-700">Assistant Professor</span> — Dept. of Cellular &amp; Molecular Medicine, University of Ottawa
          </div>
          <p class="mt-5 text-navy-700/65 text-[14px] leading-relaxed max-w-xl">
            David's research focuses on cellular plasticity in gynecologic disease. He studies how
            cells and tissues remodel during disease and therapy. He trained in ovarian cancer with
            Barbara Vanderhyden at the University of Ottawa and in spatial genomics with Jeff Wrana
            at the Lunenfeld-Tanenbaum Research Institute (Toronto, ON), with work supported by a CIHR Banting
            Postdoctoral Fellowship and recognized by a John Charles Polanyi Prize.
          </p>
        </div>

        <!-- PI links -->
        <div class="flex flex-wrap lg:flex-col gap-2">
          {piLinks.map((l) => (
            <a
              href={l.href}
              class="px-4 py-2 text-[12px] text-navy-700 border border-navy-700/20 rounded-md text-center hover:border-rust-500 hover:text-rust-500 transition-colors"
              style="min-width: 110px;"
            >
              {l.label} →
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Team wall ───────────────────────────────────────────────────── -->
  <section class="bg-white border-t border-navy-700/10">
    <div class="max-w-6xl mx-auto px-5 md:px-10 py-16">
      <div class="flex items-baseline justify-between border-b border-navy-700/10 pb-4 mb-8">
        <div class="eyebrow">LAB MEMBERS</div>
        <div class="font-mono text-navy-700/45 uppercase" style="font-size: 11px; letter-spacing: 0.10em;">
          {String(members.length).padStart(2, '0')}
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {members.map((m) => (
          <div class="bg-white border border-navy-700/10 rounded-lg p-5 flex flex-col">
            {m.photo ? (
              <img
                src={`/people/${slugify(m.name)}.jpeg`}
                alt={m.name}
                width="1200"
                height="1200"
                loading="lazy"
                class="w-full rounded-md mb-4 block"
                style="aspect-ratio: 1 / 1; object-fit: cover;"
              />
            ) : (
              <div
                class="w-full rounded-md flex items-center justify-center mb-4"
                style={`aspect-ratio: 1 / 1; background: ${dv[m.c % dv.length]}; opacity: 0.92;`}
              >
                <span
                  class="font-display text-white"
                  style="font-weight: 300; letter-spacing: -0.035em; font-size: 56px; line-height: 1;"
                >
                  {initials(m.name)}
                </span>
              </div>
            )}
            <div class="flex items-baseline justify-between gap-2">
              <div class="text-navy-700 font-semibold text-[15px]" style="letter-spacing: -0.01em;">
                {m.name}
              </div>
              {m.incoming && (
                <span
                  class="font-mono text-rust-500 uppercase shrink-0"
                  style="font-size: 9px; letter-spacing: 0.10em;"
                >
                  · INCOMING
                </span>
              )}
            </div>
            <div class="text-navy-700/65 text-[13px] mt-1 leading-snug">{m.role}</div>
            {m.note && (
              <div class="text-navy-700/45 text-[12px] mt-0.5 leading-snug">{m.note}</div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Alumni ──────────────────────────────────────────────────────── -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="max-w-6xl mx-auto px-5 md:px-10 py-16">
      <div class="flex items-baseline justify-between border-b border-navy-700/10 pb-4 mb-8">
        <div class="eyebrow">ALUMNI</div>
        <div class="font-mono text-navy-700/45 uppercase" style="font-size: 11px; letter-spacing: 0.10em;">
          {String(alumni.length).padStart(2, '0')}
        </div>
      </div>

      <div class="bg-white border border-navy-700/10 rounded-lg">
        {alumni.map((a, i) => (
          <div
            class={`px-6 py-4 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr_1.5fr_auto] items-baseline gap-1 lg:gap-6 ${i > 0 ? 'border-t border-navy-700/10' : ''}`}
          >
            <div class="text-navy-700 font-semibold text-[15px]" style="letter-spacing: -0.01em;">
              {a.name}
            </div>
            <div class="text-navy-700/65 text-[13px] leading-snug">{a.role}</div>
            <div class="text-navy-700/65 text-[13px] leading-snug">→ {a.current}</div>
            <div class="font-mono text-navy-700/45 uppercase lg:text-right" style="font-size: 11px; letter-spacing: 0.10em;">
              {a.year}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
