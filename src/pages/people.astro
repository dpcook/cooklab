---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

// Lab members — active first, then incoming.
const members = [
  // Research Associate
  { name: 'John Abou-Hamad, PhD', role: 'Research Associate', photo: true },
  // Postdoctoral Fellows
  { name: 'Sarah Nersesian, PhD', role: 'Postdoctoral Fellow', photo: true },
  { name: 'Elizabeth Hughes, PhD', role: 'Postdoctoral Fellow', photo: true },
  { name: 'Emma Gerber, PhD', role: 'Postdoctoral Fellow', photo: true },
  // PhD
  { name: 'Emma Durocher', role: 'PhD (Cellular and Molecular Medicine)', photo: true },
  { name: "Colin O'Dwyer", role: 'PhD (Microbiology and Immunology)', note: 'co-supervised w/ Dr. Michele Ardolino', photo: true },
  { name: 'Hugh Deng', role: 'PhD (Cellular and Molecular Medicine)', photo: true },
  // MSc
  { name: 'Athena Southworth', role: 'MSc (Cellular and Molecular Medicine)', photo: true },
  // Undergraduate
  { name: 'Katrina Verey', role: 'Undergraduate (TMM-PhD)', photo: true },
  { name: 'Michelle Sukadil', role: 'Undergraduate (Biomedical Sciences)', photo: true },
  { name: 'Sara Popovic', role: 'Undergraduate (Computing, Queen’s University)', photo: true },
];

const alumni = [
  { name: 'Bhavya Joshi', role: 'Undergraduate (TMM)', current: 'TBD', year: 2026 },
  { name: 'Judy Sobh', role: 'MSc (Cellular and Molecular Medicine)', current: 'TBD', year: 2026 },
  { name: 'Kiyana Rahimian', role: 'TMM Rotation Student', current: 'TBD', year: 2026 },
];

const slugify = (name: string) =>
  name.toLowerCase().split(',')[0].replace(/'/g, '').replace(/\s+/g, '-');

const initials = (name: string) =>
  name
    .split(',')[0]
    .split(/\s+/)
    .map((p) => p[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();

const piLinks = [
  { label: 'dpcook.com', href: 'https://dpcook.com' },
  { label: 'Email', href: 'mailto:dacook@ohri.ca' },
  { label: 'Google Scholar', href: 'https://scholar.google.ca/citations?hl=en&pli=1&user=aBCxvUIAAAAJ' },
  { label: 'LinkedIn', href: 'https://ca.linkedin.com/in/david-cook-43266577' },
];
---

<BaseLayout title="People — Cook Lab">
  <PageHeader title="People" cloud="/mosaic/header-people">
    We value <em>curiosity</em>, <em>care</em>, and <em>drive</em> to address the most impactful
    challenges in gynecologic disease.
    <Fragment slot="sub">
      We're always looking for talented people. <a href="/join">Join the lab →</a>
    </Fragment>
  </PageHeader>

  <!-- PI -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="wrap py-14 md:py-20 grid gap-8 md:gap-14 items-start grid-cols-1 md:grid-cols-[minmax(0,340px)_1fr]">
      <img
        src="/people/david-cook.jpeg"
        alt="David P. Cook"
        width="1200"
        height="1200"
        class="block w-full max-w-[340px] rounded-2xl"
        style="aspect-ratio: 1 / 1; object-fit: cover;"
      />
      <div class="min-w-0 md:pt-2">
        <h2 class="section-title">David P. Cook, PhD</h2>
        <p class="mt-2 mb-0 text-[16px] text-rust-500 font-medium">Principal Investigator</p>
        <p class="mt-5 mb-0 text-[15px] text-navy-700/70 leading-relaxed">
          <span class="font-semibold text-navy-700">Scientist</span> — Cancer Research Program, Ottawa Hospital Research Institute<br />
          <span class="font-semibold text-navy-700">Assistant Professor</span> — Dept. of Cellular &amp; Molecular Medicine, University of Ottawa
        </p>
        <p class="mt-5 mb-0 text-[16px] text-navy-700/80 leading-[1.7] max-w-2xl">
          David's research focuses on cellular plasticity in gynecologic disease. He studies how
          cells and tissues remodel during disease and therapy. He trained in ovarian cancer with
          Barbara Vanderhyden at the University of Ottawa and in spatial genomics with Jeff Wrana
          at the Lunenfeld-Tanenbaum Research Institute (Toronto, ON), with work supported by a CIHR Banting
          Postdoctoral Fellowship and recognized by a John Charles Polanyi Prize.
        </p>
        <ul class="mt-7 m-0 p-0 list-none flex flex-wrap gap-x-6 gap-y-2">
          {piLinks.map((l) => (
            <li><a href={l.href} class="arrow-link">{l.label} <span aria-hidden="true">→</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Lab members -->
  <section class="border-t border-navy-700/10">
    <div class="wrap py-16 md:py-24">
      <h2 class="section-title">Lab members</h2>
      <ul class="mt-10 m-0 p-0 list-none grid grid-cols-2 lg:grid-cols-3 gap-x-6 md:gap-x-8 gap-y-10">
        {members.map((m) => (
          <li>
            {m.photo ? (
              <img
                src={`/people/${slugify(m.name)}.jpeg`}
                alt={m.name}
                width="1200"
                height="1200"
                loading="lazy"
                class="block w-full rounded-xl"
                style="aspect-ratio: 1 / 1; object-fit: cover;"
              />
            ) : (
              <div class="w-full rounded-xl bg-navy-400 flex items-center justify-center" style="aspect-ratio: 1 / 1;" aria-hidden="true">
                <span class="font-display text-white" style="font-weight: 300; letter-spacing: -0.035em; font-size: clamp(36px, 6vw, 56px); line-height: 1;">
                  {initials(m.name)}
                </span>
              </div>
            )}
            <p class="mt-4 mb-0 text-[16px] font-semibold text-navy-700" style="letter-spacing: -0.01em;">{m.name}</p>
            <p class="mt-1 mb-0 text-[14px] text-navy-700/65 leading-snug">
              {m.role}{m.incoming && <span class="text-rust-500"> · Incoming</span>}
            </p>
            {m.note && <p class="mt-0.5 mb-0 meta leading-snug">{m.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Alumni -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="wrap py-16 md:py-20 grid gap-8 md:gap-12 grid-cols-1 md:grid-cols-[1fr_2.6fr]">
      <h2 class="section-title">Alumni</h2>
      <ul class="m-0 p-0 list-none">
        {alumni.map((a, i) => (
          <li class:list={['py-4 grid gap-1 md:gap-6 items-baseline grid-cols-1 md:grid-cols-[1.2fr_1.6fr_0.8fr_auto]', i > 0 && 'border-t border-navy-700/10']}>
            <span class="text-[16px] font-semibold text-navy-700">{a.name}</span>
            <span class="text-[14px] text-navy-700/65">{a.role}</span>
            <span class="text-[14px] text-navy-700/65">→ {a.current}</span>
            <span class="meta tabular-nums md:text-right">{a.year}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
