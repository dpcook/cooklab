---
import BaseLayout from '../layouts/BaseLayout.astro';

// Stylized tissue microarray: 8 × 6 cores. A stand-in until real TMA imagery is swapped in.
const fills = ['#CBD5E1', '#94A3B8', '#64748B', '#334155', '#F59065', '#C2410C'];
const weights = [4, 4, 3, 1, 1.4, 1];
const total = weights.reduce((a, b) => a + b, 0);
let s = 77;
const r = () => (s = (s * 9301 + 49297) % 233280) / 233280;
const pick = () => {
  let x = r() * total;
  for (let i = 0; i < fills.length; i++) if ((x -= weights[i]) < 0) return fills[i];
  return fills[0];
};
const tmaCols = 8;
const tmaRows = 6;
const cores = Array.from({ length: tmaCols * tmaRows }, () => {
  const empty = r() < 0.06;
  return { fill: empty ? 'none' : pick(), opacity: 0.7 + r() * 0.3, empty };
});

const stats = [
  { k: '840+', v: 'patient cases enrolled', d: '+40 Q1 2026' },
  { k: '3,200', v: 'tissue, blood, urine samples', d: 'paired clinical data' },
  { k: '48', v: 'organoid lines derived', d: 'viable + characterized' },
  { k: '142', v: 'scRNA-seq datasets', d: '~10K cells / sample' },
  { k: '50', v: 'Visium + Xenium sections', d: 'spatial transcriptomics' },
];

const fuelRows = [
  { t: 'Mapping cell-state plasticity across 142 patients.', link: 'Treatment resistance', href: '/research/ovarian-cancer' },
  { t: 'Identifying protein biomarkers for early endometriosis detection.', link: 'Early detection', href: '/research/endometriosis' },
  { t: 'Tracing the transition from endometriosis to ovarian cancer.', link: 'Progression', href: '/research/endometriosis' },
];

const paths = [
  {
    h: 'Interested in collaborating?',
    b: 'We actively collaborate with researchers who need high-quality patient samples and paired clinical data. We prioritize projects that complement our own and return insight to the broader research community.',
    cta: 'Email David',
    href: 'mailto:dacook@ohri.ca',
  },
  {
    h: 'Interested in contributing?',
    b: "Enrollment is coordinated through The Ottawa Hospital's consent and tissue program. Learn more about how the hospital collects and manages biobank samples.",
    cta: 'Learn more at OHRI',
    href: 'https://www.ohri.ca/',
  },
];
---

<BaseLayout title="Biobank — Cook Lab">
  <!-- Hero -->
  <section>
    <div class="wrap pt-14 pb-14 md:pt-20 md:pb-20 grid gap-10 md:gap-16 items-center grid-cols-1 md:grid-cols-[1.2fr_1fr]">
      <div>
        <h1 class="page-title">Ottawa GynePath Biobank</h1>
        <p class="question mt-5 mb-0 max-w-lg text-navy-700/70" style="font-size: clamp(18px, 2.4vw, 22px); line-height: 1.35;">
          The engine of our research — powered by patient partnership.
        </p>
        <div class="mt-8 max-w-xl text-[16px] leading-[1.7]">
          <p class="m-0">
            The Ottawa GynePath Biobank is a growing repository of tissue, blood, organoids, and clinical data
            contributed by patients across The Ottawa Hospital. It is the foundation every project in our lab is
            built on.
          </p>
          <p class="mt-4 mb-0 text-navy-700/70">
            Rather than a standalone initiative, the biobank is woven into everything we do: it grounds every
            hypothesis in human biology from the start, and it supports collaborators across Canada and
            internationally working on the same questions.
          </p>
        </div>
      </div>

      <svg viewBox={`0 0 ${tmaCols * 10} ${tmaRows * 10}`} class="w-full h-auto" role="img" aria-label="Stylized tissue microarray">
        {cores.map((c, i) => {
          const cx = (i % tmaCols) * 10 + 5;
          const cy = Math.floor(i / tmaCols) * 10 + 5;
          return c.empty ? (
            <circle cx={cx} cy={cy} r="4" fill="none" stroke="#CBD5E1" stroke-width="0.3" stroke-dasharray="0.8 0.8" />
          ) : (
            <circle cx={cx} cy={cy} r="4" fill={c.fill} opacity={c.opacity.toFixed(2)} />
          );
        })}
      </svg>
    </div>
  </section>

  <!-- What's in it -->
  <section class="bg-surface-200 border-y border-navy-700/10">
    <div class="wrap py-16 md:py-20">
      <h2 class="section-title">What's in it</h2>
      <dl class="mt-10 m-0 grid gap-x-8 gap-y-10 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
        {stats.map((stat) => (
          <div>
            <dt class="font-display text-navy-700" style="font-weight: 300; font-size: clamp(40px, 5vw, 54px); letter-spacing: -0.04em; line-height: 1;">
              {stat.k}
            </dt>
            <dd class="m-0 mt-3 text-[15px] text-navy-700">{stat.v}</dd>
            <dd class="m-0 mt-1 meta">{stat.d}</dd>
          </div>
        ))}
      </dl>
      <p class="meta mt-10 mb-0">Placeholder values; final numbers to come.</p>
    </div>
  </section>

  <!-- How the biobank fuels our research -->
  <section>
    <div class="wrap py-16 md:py-24">
      <h2 class="section-title">How the biobank fuels our research</h2>
      <ul class="mt-10 m-0 p-0 list-none">
        {fuelRows.map((row) => (
          <li class="border-t border-navy-700/10 last:border-b">
            <a href={row.href} class="group grid gap-2 md:gap-8 py-6 items-baseline grid-cols-1 md:grid-cols-[1fr_auto] text-navy-700 hover:text-navy-700">
              <span class="item-title group-hover:text-rust-600 transition-colors">{row.t}</span>
              <span class="arrow-link">{row.link} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- For collaborators / for patients -->
  <section class="border-t border-navy-700/10">
    <div class="wrap py-16 md:py-20 grid gap-12 md:gap-16 grid-cols-1 md:grid-cols-2">
      {paths.map((c) => (
        <div>
          <h2 class="item-title text-[26px]" style="font-weight: 300; letter-spacing: -0.03em;">{c.h}</h2>
          <p class="mt-4 mb-0 text-[15px] text-navy-700/70">{c.b}</p>
          <a href={c.href} class="arrow-link mt-5">{c.cta} <span aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
