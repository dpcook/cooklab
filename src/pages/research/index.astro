---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';

const diseases = [
  {
    name: 'Ovarian cancer',
    title: 'The most lethal gynecologic malignancy.',
    body: 'High-grade serous disease responds to first-line chemotherapy, only to return with resistance. Immunotherapies that transformed treatment in other cancers have had little benefit in ovarian cancer. We study why treatments fail and develop new therapeutic strategies.',
    kind: 'ovarian',
  },
  {
    name: 'Endometriosis',
    title: 'Chronic, under-studied, high-impact.',
    body: "Affects 1 in 10 women, causing pain, infertility, and 7–10 years of diagnostic delay. Advanced lesions carry up to a 10-fold elevated risk of ovarian cancer. We're applying the tools that transformed cancer research to close this gap.",
    kind: 'endo',
  },
];

const pillars = [
  {
    t: 'Single-cell & spatial genomics',
    b: 'We profile individual cells to reveal hidden diversity and cell states, and we map how those cells are organized in tissue. scRNA-seq, snPATHO-seq, and Xenium.',
  },
  {
    t: 'Patient-derived disease models',
    b: 'We build organoid and primary cell models from patient samples. These systems reflect human biology and let us test findings and therapeutics.',
  },
  {
    t: 'Computational biology',
    b: 'Cell-state inference, spatial neighborhood analysis, trajectory modeling, and integration across modalities.',
  },
  {
    t: 'Ottawa GynePath Biobank',
    b: 'Our research is powered by patient-contributed samples and clinical data, grounding every project in human biology from the start.',
    note: 'More info soon',
  },
];

const questionGroups = [
  {
    title: 'Ovarian cancer',
    qs: [
      { q: 'Why do high-grade serous ovarian cancers become resistant to chemotherapy after a strong initial response?', p: 'Treatment resistance' },
      { q: 'How does the biology of rare ovarian cancer subtypes differ from high-grade serous disease?', p: 'Rare subtypes' },
      { q: 'Why have immunotherapies failed in ovarian cancer?', p: 'Novel immunotherapies' },
    ],
  },
  {
    title: 'Endometriosis',
    qs: [
      { q: 'Can we detect endometriosis earlier?', p: 'Early detection' },
      { q: 'Can developments in cancer therapeutics improve outcomes for women with endometriosis?', p: 'Novel immunotherapies' },
      { q: 'How does endometriosis develop into ovarian cancer?', p: 'Progression' },
    ],
  },
];
---

<BaseLayout title="Research — Cook Lab">
  <PageHeader title="Research" cloud="/mosaic/header-research">
    We study gynecologic diseases to understand their fundamental biology and translate discoveries into
    <em>better prevention, detection, and treatment</em>.
  </PageHeader>

  <!-- Each disease, with the questions we're asking about it. The two cards share one row grid
       (subgrid), so their names, descriptions and questions line up across the row. -->
  <section>
    <div class="d-grid wrap pb-10 md:pb-12">
      {diseases.map((d) => {
        const qs = questionGroups.find((g) => g.title === d.name)?.qs ?? [];
        return (
          <article class="d-card">
            <div class="d-visual">
              {d.kind === 'ovarian' ? (
                <img
                  src="/mosaic/card-ovarian-he-520.jpg"
                  srcset="/mosaic/card-ovarian-he-520.jpg 520w, /mosaic/card-ovarian-he-1040.jpg 1040w"
                  sizes="(min-width: 768px) 520px, 100vw"
                  alt="H&E-stained section of high-grade serous ovarian cancer"
                  loading="lazy"
                  decoding="async"
                  class="d-he"
                />
              ) : (
                <img
                  src="/mosaic/card-endometriosis-he-520.jpg"
                  srcset="/mosaic/card-endometriosis-he-520.jpg 520w, /mosaic/card-endometriosis-he-1040.jpg 1040w"
                  sizes="(min-width: 768px) 520px, 100vw"
                  alt="H&E-stained endometriotic lesion: two glands in fibrotic stroma"
                  loading="lazy"
                  decoding="async"
                  class="d-he"
                />
              )}
            </div>
            <h2 class="d-name d-pad pt-6 m-0">{d.name}</h2>
            <p class="d-line d-pad mt-2 mb-0">{d.title}</p>
            <p class="d-pad mt-3 mb-0 text-[15px] text-navy-700/65">{d.body}</p>
            <ul class="d-pad mt-6 mb-0 p-0 list-none">
              {qs.map((item) => (
                <li class="py-3.5 border-t border-navy-700/10">
                  <p class="question m-0 text-[18px] text-navy-700">{item.q}</p>
                  <p class="mt-1 mb-0 text-[14px] font-medium text-rust-500">{item.p}</p>
                </li>
              ))}
            </ul>
            <p class="d-pad meta pt-5 pb-7 md:pb-8 m-0 border-t border-navy-700/10">More info soon</p>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Approach: four pillars in a row -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="wrap pt-10 pb-14 md:pt-12 md:pb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-x-12 gap-y-3">
        <h2 class="section-title">Our approach</h2>
        <p class="m-0 max-w-md text-[16px] text-navy-700/65">
          We integrate experimental and computational methods to understand disease at unprecedented resolution.
        </p>
      </div>
      <div class="mt-10 grid gap-x-8 gap-y-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        {pillars.map((p) => (
          <div class="border-t border-navy-700/15 pt-5">
            <h3 class="pillar m-0">{p.t}</h3>
            <p class="mt-3 mb-0 text-[15px] text-navy-700/70">{p.b}</p>
            {p.note && <span class="block mt-2 meta">{p.note}</span>}
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .d-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px 32px;
  }
  .d-card {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: 0;
    border: 1px solid rgb(15 23 42 / 0.1);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }
  @media (min-width: 768px) {
    .d-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .d-pad { padding-left: 28px; padding-right: 28px; }
  @media (min-width: 768px) {
    .d-pad { padding-left: 36px; padding-right: 36px; }
  }
  .d-visual {
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgb(15 23 42 / 0.08);
  }
  .d-he {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Disease names bold, like the page names; the line under them light */
  .d-name {
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .d-line {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: rgb(15 23 42 / 0.75);
  }
  .pillar {
    font-weight: 600;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
</style>
