---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CellPlot from '../../components/CellPlot.astro';
import DiagnosisTimeline from '../../components/DiagnosisTimeline.astro';

const diseases = [
  {
    name: 'Ovarian cancer',
    title: 'The most lethal gynecologic malignancy.',
    body: 'High-grade serous disease responds to first-line chemotherapy, only to return with resistance. Immunotherapies that transformed treatment in other cancers have had little benefit in ovarian cancer. We study why treatments fail and develop new therapeutic strategies.',
    stat: '<50%',
    statLabel: 'five-year survival',
    kind: 'ovarian',
  },
  {
    name: 'Endometriosis',
    title: 'Chronic, under-studied, high-impact.',
    body: "Affects 1 in 10 women, causing pain, infertility, and 7–10 years of diagnostic delay. Advanced lesions carry up to a 10-fold elevated risk of ovarian cancer. We're applying the tools that transformed cancer research to close this gap.",
    stat: '1 in 10',
    statLabel: 'women affected',
    kind: 'endo',
  },
];

const pillars = [
  {
    t: 'Single-cell & spatial genomics',
    b: 'We profile individual cells to reveal hidden diversity and cell states, and we map how those cells are organized in tissue. scRNA-seq, snPATHO-seq, and Xenium.',
  },
  {
    t: 'Patient-derived disease models',
    b: 'We build organoid and primary cell models from patient samples. These systems reflect human biology and let us test findings and therapeutics.',
  },
  {
    t: 'Computational biology',
    b: 'Cell-state inference, spatial neighborhood analysis, trajectory modeling, and integration across modalities.',
  },
  {
    t: 'Ottawa GynePath Biobank',
    b: 'Our research is powered by patient-contributed samples and clinical data, grounding every project in human biology from the start.',
    note: 'More info soon',
  },
];

const questionGroups = [
  {
    title: 'Ovarian cancer',
    qs: [
      { q: 'Why do high-grade serous ovarian cancers become resistant to chemotherapy after a strong initial response?', p: 'Treatment resistance' },
      { q: 'How does the biology of rare ovarian cancer subtypes differ from high-grade serous disease?', p: 'Rare subtypes' },
      { q: 'Why have immunotherapies failed in ovarian cancer?', p: 'Novel immunotherapies' },
    ],
  },
  {
    title: 'Endometriosis',
    qs: [
      { q: 'Can we detect endometriosis earlier?', p: 'Early detection' },
      { q: 'Can developments in cancer therapeutics improve outcomes for women with endometriosis?', p: 'Novel immunotherapies' },
      { q: 'How does endometriosis develop into ovarian cancer?', p: 'Progression' },
    ],
  },
];
---

<BaseLayout title="Research — Cook Lab">
  <!-- Header -->
  <section>
    <div class="wrap pt-14 pb-12 md:pt-20 md:pb-14">
      <h1 class="page-title max-w-4xl">
        We study gynecologic diseases to understand their fundamental biology and translate discoveries into
        <em class="text-rust-500" style="font-style: italic; font-weight: 300;">better prevention, detection, and treatment</em>.
      </h1>
    </div>
  </section>

  <!-- Disease focus -->
  <section>
    <div class="wrap pb-16 md:pb-24 grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {diseases.map((d) => (
        <article class="flex flex-col rounded-2xl border border-navy-700/10 overflow-hidden">
          <div class="dark-band h-[230px] relative">
            {d.kind === 'ovarian' ? (
              <CellPlot mode="tissue" fit="cover" class="absolute inset-0" />
            ) : (
              <div class="absolute inset-0 flex items-center px-7 md:px-9">
                <DiagnosisTimeline compact class="w-full" />
              </div>
            )}
          </div>
          <div class="p-7 md:p-9 flex flex-col flex-1">
            <h2 class="item-title text-[28px]" style="font-weight: 300; letter-spacing: -0.03em;">{d.name}</h2>
            <p class="mt-2 mb-0 text-[17px] text-navy-700">{d.title}</p>
            <p class="mt-3 mb-0 text-[15px] text-navy-700/65">{d.body}</p>
            <div class="mt-auto pt-7 flex items-baseline gap-3">
              <span class="stat text-[40px]">{d.stat}</span>
              <span class="meta">{d.statLabel}</span>
              <span class="flex-1"></span>
              <span class="meta italic">More info soon</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Research questions -->
  <section class="border-t border-navy-700/10">
    <div class="wrap py-16 md:py-24">
      <h2 class="section-title">What we're asking</h2>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-10">
        {questionGroups.map((g) => (
          <div>
            <h3 class="font-sans text-[15px] font-semibold tracking-normal text-navy-700">{g.title}</h3>
            <ul class="mt-3 m-0 p-0 list-none">
              {g.qs.map((item) => (
                <li class="py-5 border-t border-navy-700/10">
                  <p class="question m-0 text-[20px] text-navy-700">{item.q}</p>
                  <p class="mt-2 mb-0 text-[14px] font-medium text-rust-500">{item.p}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="bg-surface-200 border-t border-navy-700/10">
    <div class="wrap py-16 md:py-24 grid gap-8 md:gap-14 grid-cols-1 md:grid-cols-[1fr_1.9fr]">
      <div>
        <h2 class="section-title">Our approach</h2>
        <p class="mt-4 mb-0 text-[16px] text-navy-700/65 max-w-sm">
          We integrate experimental and computational methods to understand disease at unprecedented resolution.
        </p>
      </div>
      <dl class="m-0">
        {pillars.map((p, i) => (
          <div class:list={['grid gap-2 md:gap-8 py-6 grid-cols-1 md:grid-cols-[0.9fr_1.4fr]', i > 0 && 'border-t border-navy-700/10']}>
            <dt class="item-title">{p.t}</dt>
            <dd class="m-0 text-[15px] text-navy-700/70">
              {p.b}
              {p.note && <span class="block mt-2 meta italic">{p.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
